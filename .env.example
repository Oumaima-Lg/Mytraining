# ─── Postgres ───────────────────────────────────────────────
POSTGRES_USER=prep
POSTGRES_PASSWORD=prep_password
POSTGRES_DB=prep_entretien
# Consumed by Flask (SQLAlchemy). Host is the compose service name.
DATABASE_URL=postgresql+psycopg2://prep:prep_password@postgres:5432/prep_entretien

# ─── MinIO (S3-compatible object storage) ───────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000            # internal endpoint used by Flask
MINIO_PUBLIC_ENDPOINT=localhost:9000 # endpoint baked into presigned URLs (browser-reachable)
MINIO_BUCKET=prep-entretien
MINIO_SECURE=false

# ─── Flask ──────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-in-prod
JWT_SECRET_KEY=change-me-too-in-prod
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30
# CORS origin of the Next.js app
FRONTEND_ORIGIN=http://localhost:3000

# ─── AI ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_GENERATE_MODEL=claude-sonnet-4-6
ANTHROPIC_SCORE_MODEL=claude-opus-4-8
WHISPER_MODEL=base                   # faster-whisper size: tiny|base|small|medium

# ─── Next.js (web) ──────────────────────────────────────────
# Server-side base URL the BFF route handlers use to reach Flask.
API_INTERNAL_URL=http://api:5000
# Public URL (rarely needed; BFF proxies everything).
NEXT_PUBLIC_APP_NAME=PrepEntretien
